    "pack:models": "node tools/pack-models.mjs",
    "probe:input": "vite-node tools/probe-input.ts",
    "probe:town": "vite-node tools/probe-town.ts",
    "probe:village": "vite-node tools/probe-village.ts",
    "probe:house1": "vite-node tools/probe-house1.ts",
    "probe:net": "vite-node tools/probe-net.ts",
    "probe:camera": "vite-node tools/probe-camera.ts",
    "publish:prep": "npm run build:file && cp dist-file/index.html \"$CP_PUBLISH_HTML\"",
    "probe:dog": "vite-node tools/probe-dog.ts",
    "probe:peer": "vite-node tools/probe-peer.ts",
    "probe:weapon": "vite-node tools/probe-weapon.ts"
